[Unit]
Description=Refresh Home Hub RSS feeds
After=network-online.target homehub.service
Wants=network-online.target

[Service]
Type=oneshot
User=homehub
Group=homehub
WorkingDirectory=/opt/homehub
EnvironmentFile=/etc/homehub/homehub.env
ExecStart=/opt/homehub/.venv/bin/homehub-rss-refresh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homehub
MemoryMax=128M
