[Unit]
Description=Home Hub family dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homehub
Group=homehub
WorkingDirectory=/opt/homehub
EnvironmentFile=/etc/homehub/homehub.env
ExecStart=/opt/homehub/.venv/bin/homehub
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homehub
MemoryMax=256M

[Install]
WantedBy=multi-user.target
