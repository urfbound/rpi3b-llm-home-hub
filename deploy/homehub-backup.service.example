[Unit]
Description=Create and verify a Home Hub database backup
After=homehub.service

[Service]
Type=oneshot
User=homehub
Group=homehub
WorkingDirectory=/opt/homehub
EnvironmentFile=/etc/homehub/homehub.env
ExecStart=/opt/homehub/.venv/bin/homehub-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homehub
MemoryMax=256M
